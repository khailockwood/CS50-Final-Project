bash -v testing.sh
#!/bin/bash

# Khai Lockwood, Gift Christian, 5/30/2026, CS50 TSE Querier
# regression tests for the querier

set -u       # blow up if i ever use a variable i forgot to set

DIR=test-data/tiny           # the little hand-built page directory
IDX=test-data/tiny.index     # the matching index file
BAD=/no/such/path            # a path that doesn't exist, for the error tests

# 1. command-line argument checks

# no arguments at all, so it should print usage
./querier
usage: ./querier pageDirectory indexFilename

# only one argument, still wrong, should print usage
./querier $DIR
usage: ./querier pageDirectory indexFilename

# three arguments, one too many, should print usage
./querier $DIR $IDX extra
usage: ./querier pageDirectory indexFilename

# page directory that doesn't exist, should say it's not a crawler dir
./querier $BAD $IDX
Error: '/no/such/path' is not a crawler directory

# page directory that exists but has no .crawler sentinel, same complaint
./querier . $IDX
Error: '.' is not a crawler directory

# index file that doesn't exist, should say it can't read the index
./querier $DIR $BAD
Error: cannot read index from '/no/such/path'

# 2. the score table from the requirements spec
# the tiny index reproduces the three-document example in REQUIREMENTS.md
# (FILE1/FILE2/FILE3 with cat, dog, emu), so i can check the rankings exactly:
# cat and dog gives FILE3 a score of 3, the highest
# cat or dog gives FILE3 a score of 7, the highest
# dog or dog gives FILE1 a score of 10, the highest
# cat and dog or emu gives FILE1 a score of 7, the highest

./querier $DIR $IDX <<EOF
cat and dog
cat or dog
dog or dog
cat and dog or emu
EOF
Query: cat and dog
Matches 2 documents (ranked):
score   3 doc    3: https://example.com/3
score   2 doc    2: https://example.com/2
Query: cat or dog
Matches 3 documents (ranked):
score   7 doc    3: https://example.com/3
score   5 doc    2: https://example.com/2
score   5 doc    1: https://example.com/1
Query: dog or dog
Matches 3 documents (ranked):
score  10 doc    1: https://example.com/1
score   8 doc    3: https://example.com/3
score   4 doc    2: https://example.com/2
Query: cat and dog or emu
Matches 3 documents (ranked):
score   7 doc    1: https://example.com/1
score   3 doc    2: https://example.com/2
score   3 doc    3: https://example.com/3

# 3. the syntax error messages from the spec
# operator-first, operator-last, two-operators-adjacent, and the
# bad-character cases are all here

./querier $DIR $IDX <<EOF
and
or
and earth
or earth
planet earth or
planet earth and
planet earth and or science
planet earth and and science
planet earth or and science
Warning!
(The Lunar Chronicles #4.5)
git-flow
EOF
Query: and
Error: 'and' cannot be first
Query: or
Error: 'or' cannot be first
Query: and earth
Error: 'and' cannot be first
Query: or earth
Error: 'or' cannot be first
Query: planet earth or
Error: 'or' cannot be last
Query: planet earth and
Error: 'and' cannot be last
Query: planet earth and or science
Error: 'and' and 'or' cannot be adjacent
Query: planet earth and and science
Error: 'and' and 'and' cannot be adjacent
Query: planet earth or and science
Error: 'or' and 'and' cannot be adjacent
Error: bad character '!' in query.
Error: bad character '(' in query.
Error: bad character '-' in query.


# 4. whitespace, case folding, short words, and empty input
./querier $DIR $IDX <<EOF
   DARTMOUTH    College
   cat   AND   dog
a cat dog
EOF
Query: dartmouth college
No documents match.
Query: cat and dog
Matches 2 documents (ranked):
score   3 doc    3: https://example.com/3
score   2 doc    2: https://example.com/2
Query: a cat dog
No documents match.

# empty input file, the querier should just exit cleanly with no output
./querier $DIR $IDX </dev/null


# 5. one big scripted batch of queries in a single run
./querier $DIR $IDX <<EOF
cat
dog
emu
cat dog
cat or emu
cat and emu
notInTheIndex
EOF
Query: cat
Matches 2 documents (ranked):
score   3 doc    2: https://example.com/2
score   3 doc    3: https://example.com/3
Query: dog
Matches 3 documents (ranked):
score   5 doc    1: https://example.com/1
score   4 doc    3: https://example.com/3
score   2 doc    2: https://example.com/2
Query: emu
Matches 2 documents (ranked):
score   7 doc    1: https://example.com/1
score   1 doc    2: https://example.com/2
Query: cat dog
Matches 2 documents (ranked):
score   3 doc    3: https://example.com/3
score   2 doc    2: https://example.com/2
Query: cat or emu
Matches 3 documents (ranked):
score   7 doc    1: https://example.com/1
score   4 doc    2: https://example.com/2
score   3 doc    3: https://example.com/3
Query: cat and emu
Matches 1 documents (ranked):
score   1 doc    2: https://example.com/2
Query: notintheindex
No documents match.
